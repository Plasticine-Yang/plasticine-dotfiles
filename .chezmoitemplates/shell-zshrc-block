# Shared composer for the independently marked Plasticine shell block in the
# Owner-controlled .zshrc. Emits the canonical block and replaces at most one
# valid selected block byte-for-byte, without interpreting outside content.
plasticine_shell_emit_block() {
    cat <<'PLASTICINE_SHELL_BLOCK'
# >>> Plasticine shell >>>
if [ -r "$HOME/.plasticine/zsh/shared.zsh" ]; then
    if ! . "$HOME/.plasticine/zsh/shared.zsh"; then
        if [[ -o interactive ]]; then
            print -ru2 -- "plasticine: shared shell configuration unavailable"
        fi
    fi
fi
# <<< Plasticine shell <<<
PLASTICINE_SHELL_BLOCK
}

plasticine_shell_scan() {
    # Numeric input keeps NULs, unterminated lines and arbitrary outside bytes
    # out of shell variables. Output is only byte offsets: start, length, total.
    { LC_ALL=C od -An -v -tu1 "$1" || printf 'PLASTICINE_READ_ERROR\n'; } |
        LC_ALL=C awk '
            function line_done(    text, token, parts, n) {
                text = line
                if (text == "# >>> Plasticine shell >>>") {
                    if (state != 0) bad = 1
                    start = line_start; state = 1
                } else if (text == "# <<< Plasticine shell <<<") {
                    if (state != 1) bad = 1
                    finish = offset; state = 2
                } else {
                    # Recognize damaged selected markers, not arbitrary Owner
                    # text mentioning another tool.
                    text = line
                    sub(/^[ \t]*#[ \t]*[<>]*[ \t]*Plasticine[ \t]+/, "", text)
                    if (text != line) {
                        n = split(text, parts, /[ \t\r<>]/)
                        token = parts[1]
                        if (token == "shell") bad = 1
                    }
                }
                line = ""; line_start = offset
            }
            BEGIN { start = -1; state = 0; offset = 0; line_start = 0 }
            /PLASTICINE_READ_ERROR/ { bad = 1; next }
            {
                for (i = 1; i <= NF; i++) {
                    byte = $i + 0; offset++
                    if (byte == 10) line_done()
                    else line = line sprintf("%c", byte)
                }
            }
            END {
                if (line_start != offset) line_done()
                if (bad || state == 1) exit 1
                if (start == -1) print -1, 0, offset
                else print start, finish - start, offset
            }
        '
}

plasticine_shell_compose() {
    plasticine_shell_offsets=$(plasticine_shell_scan "$1") || {
        printf '%s\n' '.zshrc 中的 Plasticine shell 区块损坏或重复，未进行修改；请先手动修复。' >&2
        return 1
    }
    plasticine_shell_start=${plasticine_shell_offsets%% *}
    plasticine_shell_rest=${plasticine_shell_offsets#* }
    plasticine_shell_length=${plasticine_shell_rest%% *}
    if [ "$plasticine_shell_start" -eq -1 ]; then
        plasticine_shell_emit_block
        cat "$1"
    else
        dd if="$1" bs=1 count="$plasticine_shell_start" 2>/dev/null || return 1
        plasticine_shell_emit_block
        dd if="$1" bs=1 skip=$((plasticine_shell_start + plasticine_shell_length)) 2>/dev/null || return 1
    fi
}
