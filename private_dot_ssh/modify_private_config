#!/bin/sh
set -eu

begin_marker='# BEGIN plasticine-dotfiles github-ssh'
end_marker='# END plasticine-dotfiles github-ssh'
include_line='Include ~/.ssh/config.d/00-plasticine-github.conf'

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/plasticine-ssh-config.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

input_file=$work_dir/input
stripped_file=$work_dir/stripped
candidate_file=$work_dir/candidate
effective_file=$work_dir/effective
existing_effective_file=$work_dir/existing-effective
default_effective_file=$work_dir/default-effective

cat > "$input_file"

awk -v begin="$begin_marker" -v end="$end_marker" '
    $0 == begin {
        if (inside || seen) exit 20
        inside = 1
        seen = 1
        next
    }
    $0 == end {
        if (!inside) exit 21
        inside = 0
        next
    }
    !inside { print }
    END {
        if (inside) exit 22
    }
' "$input_file" > "$stripped_file" || {
    printf '%s\n' 'GitHub SSH 托管区块损坏或重复，请先手动修复 ~/.ssh/config。' >&2
    exit 1
}

if ! ssh -G -F /dev/null github.com > "$default_effective_file" 2>/dev/null ||
   ! ssh -G -F "$stripped_file" github.com > "$existing_effective_file" 2>/dev/null; then
    printf '%s\n' '现有 ~/.ssh/config 无法被 OpenSSH 解析，未进行修改。' >&2
    exit 1
fi

default_user=$(awk '$1 == "user" { print $2; exit }' "$default_effective_file")
existing_user=$(awk '$1 == "user" { print $2; exit }' "$existing_effective_file")
default_host=$(awk '$1 == "hostname" { print $2; exit }' "$default_effective_file")
existing_host=$(awk '$1 == "hostname" { print $2; exit }' "$existing_effective_file")
default_identities=$(awk '$1 == "identityfile" { print $2 }' "$default_effective_file")
existing_identities=$(awk '$1 == "identityfile" { print $2 }' "$existing_effective_file")

if { [ "$existing_user" != "$default_user" ] && [ "$existing_user" != git ]; } ||
   [ "$existing_host" != "$default_host" ] ||
   [ "$existing_identities" != "$default_identities" ]; then
    printf '%s\n' '已有 SSH 规则会改变 github.com 的用户、主机或私钥，未进行修改。' >&2
    exit 1
fi

{
    cat <<'EOF'
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_github
    IdentitiesOnly yes

Host *
EOF
    cat "$stripped_file"
} > "$candidate_file"

if ! ssh -G -F "$candidate_file" github.com > "$effective_file" 2>/dev/null; then
    printf '%s\n' '现有 ~/.ssh/config 无法被 OpenSSH 解析，未进行修改。' >&2
    exit 1
fi

identity_count=$(awk '$1 == "identityfile" { count++ } END { print count + 0 }' "$effective_file")
identity_file=$(awk '$1 == "identityfile" { print $2 }' "$effective_file")
expected_identity_file=$(printf '\176/.ssh/id_github')
effective_user=$(awk '$1 == "user" { print $2; exit }' "$effective_file")
effective_host=$(awk '$1 == "hostname" { print $2; exit }' "$effective_file")
identities_only=$(awk '$1 == "identitiesonly" { print $2; exit }' "$effective_file")

if [ "$identity_count" -ne 1 ] || [ "$identity_file" != "$expected_identity_file" ]; then
    printf '%s\n' '已有 SSH 规则为 github.com 配置了其他 IdentityFile，未进行修改。' >&2
    exit 1
fi

if [ "$effective_user" != git ] || [ "$effective_host" != github.com ] || [ "$identities_only" != yes ]; then
    printf '%s\n' '已有 SSH 规则与 GitHub 配置冲突，未进行修改。' >&2
    exit 1
fi

printf '%s\n%s\n%s\n' "$begin_marker" "$include_line" "$end_marker"
if [ -s "$stripped_file" ]; then
    cat "$stripped_file"
fi
