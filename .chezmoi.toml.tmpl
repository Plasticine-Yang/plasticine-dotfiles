{{- if not (has .chezmoi.os (list "darwin" "linux")) -}}
{{- fail "仅支持 macOS 和 Linux。" -}}
{{- end -}}
{{- $nonInteractive := eq (env "PLASTICINE_NONINTERACTIVE") "1" -}}
{{- $allowedTools := list "github-ssh" "lazygit" "shell" -}}
{{- $tools := list -}}
{{- if $nonInteractive -}}
{{- range $requestedTool := splitList " " (trim (env "PLASTICINE_TOOLS")) -}}
{{- if ne $requestedTool "" -}}
{{- if not (has $requestedTool $allowedTools) -}}
{{- fail (printf "不支持的工具：%s" $requestedTool) -}}
{{- end -}}
{{- $tools = append $tools $requestedTool -}}
{{- end -}}
{{- end -}}
{{- $tools = uniq $tools | sortAlpha -}}
{{- else -}}
{{- $tools = promptMultichoice "选择要处理的工具（空格切换，回车确认；不选则跳过）" $allowedTools -}}
{{- end -}}
{{- if or (has "shell" $tools) (has "lazygit" $tools) -}}
{{- $zshrcInfo := lstat (joinPath .chezmoi.destDir ".zshrc") -}}
{{- if and $zshrcInfo (ne $zshrcInfo.type "file") -}}
{{- fail "~/.zshrc 必须是普通文件，不能是符号链接、目录或其他非普通文件。" -}}
{{- end -}}
{{- end -}}
{{- if has "shell" $tools -}}
{{- $destDir := .chezmoi.destDir -}}
{{- range $parent := list ".plasticine" ".plasticine/zsh" -}}
{{- $info := lstat (joinPath $destDir $parent) -}}
{{- if and $info (ne $info.type "dir") -}}
{{- fail (printf "shell: ~/%s 必须是普通目录，不能是符号链接或其他非目录。" $parent) -}}
{{- end -}}
{{- end -}}
{{- range $target := list ".zsh_plugins.txt" ".p10k.zsh" ".plasticine/zsh/shared.zsh" -}}
{{- $info := lstat (joinPath $destDir $target) -}}
{{- if and $info (ne $info.type "file") -}}
{{- fail (printf "shell: ~/%s 必须是普通文件，不能是符号链接、目录或其他非普通文件。" $target) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $key := "" -}}
{{- $sourceFingerprint := "" -}}
{{- $replaceFingerprint := "" -}}
{{- $test := false -}}
{{- if has "github-ssh" $tools -}}
{{- if $nonInteractive -}}
{{- $key = env "PLASTICINE_GITHUB_SSH_KEY" -}}
{{- else -}}
{{- $key = promptString "GitHub SSH 私钥路径（绝对路径或 ~/ 开头）" -}}
{{- end -}}
{{- if hasPrefix "~/" $key -}}
{{- $key = joinPath .chezmoi.homeDir (trimPrefix "~/" $key) -}}
{{- end -}}
{{- if or (not (hasPrefix "/" $key)) (contains "\n" $key) (contains "\r" $key) (contains "\x00" $key) -}}
{{- fail "请输入绝对路径或 ~/ 开头的私钥路径，路径不能包含换行符。" -}}
{{- end -}}
{{- $info := lstat $key -}}
{{- if not $info -}}
{{- fail (printf "私钥文件不存在：%s" $key) -}}
{{- else if ne $info.type "file" -}}
{{- fail "私钥必须是普通文件，不能是目录或符号链接。" -}}
{{- end -}}
{{- $firstLine := trim (output "head" "-n" "1" $key) -}}
{{- if not (regexMatch "^-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----$" $firstLine) -}}
{{- fail "指定文件不是受支持的 SSH 私钥。" -}}
{{- end -}}
{{- $fingerprintOutput := output "ssh-keygen" "-lf" $key -}}
{{- $sourceFingerprint = index (splitList " " $fingerprintOutput) 1 -}}
{{- $targetKey := joinPath .chezmoi.destDir ".ssh" "id_github" -}}
{{- $targetInfo := lstat $targetKey -}}
{{- if and $targetInfo (ne $targetInfo.type "file") -}}
{{- fail "~/.ssh/id_github 必须是普通文件，不能是目录或符号链接。" -}}
{{- end -}}
{{- if and $targetInfo (ne (clean $key) (clean $targetKey)) -}}
{{- $targetFingerprintOutput := output "ssh-keygen" "-lf" $targetKey -}}
{{- $targetFingerprint := index (splitList " " $targetFingerprintOutput) 1 -}}
{{- if ne $sourceFingerprint $targetFingerprint -}}
{{- if $nonInteractive -}}
{{- if ne (env "PLASTICINE_REPLACE_GITHUB_SSH_KEY") "1" -}}
{{- fail (printf "~/.ssh/id_github 已存在（%s）；需要显式允许替换为 %s。" $targetFingerprint $sourceFingerprint) -}}
{{- end -}}
{{- else -}}
{{- if not (promptBool (printf "~/.ssh/id_github 已存在（%s），是否替换为 %s" $targetFingerprint $sourceFingerprint) false) -}}
{{- fail "已取消替换 GitHub SSH 私钥。" -}}
{{- end -}}
{{- end -}}
{{- $replaceFingerprint = $targetFingerprint -}}
{{- end -}}
{{- end -}}
{{- if $nonInteractive -}}
{{- $test = eq (env "PLASTICINE_GITHUB_SSH_TEST") "1" -}}
{{- else -}}
{{- $test = promptBool "配置完成后测试 GitHub SSH 连接" false -}}
{{- end -}}
{{- end -}}
[data]
    tools = {{ $tools | default (list) | toJson }}
    githubSSHKeyPath = {{ $key | toJson }}
    githubSSHKeyFingerprint = {{ $sourceFingerprint | toJson }}
    githubSSHReplaceFingerprint = {{ $replaceFingerprint | toJson }}
    githubSSHTest = {{ $test }}
