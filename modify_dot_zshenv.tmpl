#!/bin/sh
set -eu

{{ template "zsh-environment-integration-blocks" . }}
plasticine_integration_file=.zshenv
plasticine_integration_position=append
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/plasticine-zshenv.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
cat > "$work_dir/input"
plasticine_integration_compose "$work_dir/input" "$work_dir/output"
cat "$work_dir/output"
