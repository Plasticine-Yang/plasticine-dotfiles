{{- if has "git-config" .tools -}}
#!/bin/sh
set -eu

dest_dir={{ template "shell-quote" .chezmoi.destDir }}
source_dir={{ template "shell-quote" .chezmoi.sourceDir }}
git_config=$dest_dir/.gitconfig
candidate=$source_dir/dot_gitconfig
backup_dir=$dest_dir/.plasticine/backups/git-config
pending_mode=$backup_dir/pending-mode

{{ template "whole-file-protection" . }}

# Recover an Owner mode left pending by an interrupted earlier apply before
# recording the current destination state.
plasticine_whole_file_restore_modes "$pending_mode" "$dest_dir" git-config .gitconfig
plasticine_whole_file_backup_if_changed "$git_config" "$candidate" \
    "$backup_dir" .gitconfig

if [ -f "$git_config" ]; then
    work_dir=$(mktemp -d "${TMPDIR:-/tmp}/plasticine-git-config.XXXXXX")
    trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
    : > "$work_dir/modes"
    plasticine_whole_file_record_mode "$git_config" "$dest_dir" 644 \
        "$work_dir/modes" git-config
    plasticine_whole_file_publish_modes "$work_dir/modes" "$pending_mode" \
        "$backup_dir"
fi
{{- end }}
