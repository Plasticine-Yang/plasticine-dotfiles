{{- if has "shell" .tools -}}
#!/bin/sh
set -eu

dest_dir={{ template "shell-quote" .chezmoi.destDir }}
source_dir={{ template "shell-quote" .chezmoi.sourceDir }}

plugins=$dest_dir/.zsh_plugins.txt
p10k=$dest_dir/.p10k.zsh
shared=$dest_dir/.plasticine/zsh/shared.zsh
plasticine_dir=$dest_dir/.plasticine
backup_dir=$plasticine_dir/backups/shell
pending_modes=$backup_dir/pending-modes

shell_error() {
    printf 'plasticine-dotfiles: shell: %s\n' "$1" >&2
}

{{ template "whole-file-protection" . }}

# A previous apply may have failed after recording modes; restore them before
# recording this run's modes so Owner modes survive retries.
plasticine_whole_file_restore_modes "$pending_modes" "$dest_dir" shell

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/plasticine-shell.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
plasticine_whole_file_backup_if_changed "$plugins" "$source_dir/dot_zsh_plugins.txt" "$backup_dir" "${plugins##*/}"
plasticine_whole_file_backup_if_changed "$p10k" "$source_dir/dot_p10k.zsh" "$backup_dir" "${p10k##*/}"
plasticine_whole_file_backup_if_changed "$shared" "$source_dir/dot_plasticine/zsh/shared.zsh" "$backup_dir" "${shared##*/}"

# chezmoi owns the file modes derived from the source tree. Record any Owner
# mode and normalize before apply; the matching run_after script restores it.
umask 077
: > "$work_dir/modes"
for shell_target in "$plugins" "$p10k" "$shared"; do
    if [ -f "$shell_target" ]; then
        plasticine_whole_file_record_mode "$shell_target" "$dest_dir" 644 "$work_dir/modes" shell || {
            shell_error "无法保护文件权限：~/${shell_target#"$dest_dir"/}"
            exit 1
        }
    fi
done
plasticine_whole_file_publish_modes "$work_dir/modes" "$pending_modes" "$backup_dir"
{{- end }}
