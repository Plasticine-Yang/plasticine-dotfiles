{{- if has "shell" .tools -}}
#!/bin/sh
set -eu

dest_dir={{ template "shell-quote" .chezmoi.destDir }}
source_dir={{ template "shell-quote" .chezmoi.sourceDir }}
pending_modes=$dest_dir/.plasticine/backups/shell/pending-modes

# Owner modes must be restored before chsh; pending-modes may still be present.
if [ -f "$pending_modes" ]; then
    while IFS=' ' read -r shell_mode shell_relative; do
        [ -n "$shell_mode" ] || continue
        chmod "$shell_mode" "$dest_dir/$shell_relative"
    done < "$pending_modes"
    rm -f "$pending_modes"
fi

# shellcheck disable=SC1091
. "$source_dir/lib/shell-bootstrap.sh"
plasticine_shell_plan "$dest_dir" || exit 1
plasticine_shell_transition || exit 1
{{- end }}
