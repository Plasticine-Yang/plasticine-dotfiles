{{- if or (has "shell" .tools) (has "lazygit" .tools) -}}
#!/bin/sh
set -eu
dest_dir={{ template "shell-quote" .chezmoi.destDir }}
pending=$dest_dir/.plasticine/backups/integration-blocks/pending-mode
if [ -f "$pending" ]; then
    IFS= read -r owner_mode < "$pending"
    chmod "$owner_mode" "$dest_dir/.zshrc"
    rm -f "$pending"
fi
{{- end }}
